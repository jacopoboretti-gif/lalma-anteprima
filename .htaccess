# ─────────────────────────────────────────────────────────────────────────────
# Configurazione Apache per Hostinger.
# Questo file viene copiato in dist/ dalla build e caricato in public_html/.
# ─────────────────────────────────────────────────────────────────────────────

# Pagina di errore personalizzata.
# Astro genera la 404 come file singolo /404.html, non come cartella:
# verificato sull'output della build.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Sempre HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Un solo host canonico: senza www → con www.
  # ⚠️ DA VERIFICARE: se il dominio definitivo è SENZA www, invertire questa
  #    regola. Deve corrispondere a SITE.url in src/config/site.ts, altrimenti
  #    canonical e redirect si contraddicono.
  RewriteCond %{HTTP_HOST} ^lalma\.it$ [NC]
  RewriteRule ^(.*)$ https://www.lalma.it/$1 [R=301,L]
</IfModule>

# Compressione: il sito è quasi tutto testo, qui si guadagna molto.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # I file con hash nel nome (CSS, JS, caratteri) non cambiano mai a parità di
  # nome: si possono tenere in cache per un anno.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Le immagini le sostituisce Jacopo a mano, spesso con lo stesso nome:
  # una settimana evita che una foto aggiornata resti invisibile per mesi.
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"

  # L'HTML no: deve poter cambiare subito.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
